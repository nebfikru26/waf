# ─────────────────────────────────────────────────────────────────────────────
# AffiniSecurity WAF — Environment Variable Template
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<strong_random_password>
WAF_AUDIT_PASSWORD=<strong_random_password>
CLICKHOUSE_PASSWORD=<strong_random_password>

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
# Minimum 32 bytes, generated with: openssl rand -hex 32
WAF_JWT_SECRET=<generate_with_openssl_rand_-hex_32>
WAF_JWT_ISSUER=https://api.affinisecurity.io
WAF_JWT_AUDIENCE=affinisecurity-waf

# ── Bot Protection ────────────────────────────────────────────────────────────
# Minimum 32 bytes, generated with: openssl rand -hex 32
CHALLENGE_SECRET=<generate_with_openssl_rand_-hex_32>

# ── Sidecar ───────────────────────────────────────────────────────────────────
# Minimum 64 hex chars, generated with: openssl rand -hex 32
SIDECAR_SIGNING_SECRET=<generate_with_openssl_rand_-hex_32>

# ── Threat Intelligence APIs ──────────────────────────────────────────────────
OTX_API_KEY=<your_alienvault_otx_api_key>
ABUSECH_API_KEY=<your_abusech_api_key>

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://app.affinisecurity.io,https://admin.affinisecurity.io

# ── CRS Updater ───────────────────────────────────────────────────────────────
CRS_UPDATER_ADMIN_PASSWORD=<strong_random_password>

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=<strong_random_password>
